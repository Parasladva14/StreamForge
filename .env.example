# StreamForge Fleet Monitoring System Root Environment Configuration

# Backend / API
APP_NAME=StreamForge
VERSION=1.0.0
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/streamforge
KAFKA_BOOTSTRAP_SERVER=localhost:9092
KAFKA_TOPIC_TEMPERATURE=truck-temperature
KAFKA_TOPIC_EVENTS=fleet-events
